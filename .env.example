# Supabase project URL — Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key — safe for the client, but this app only ever
# uses it server-side. RLS restricts it to INSERT-only on the waitlist table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NOTE: the service role key is intentionally NOT used anywhere in this app.
# Do not add it here.
